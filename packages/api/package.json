    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.10.2",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.2",
    "openai": "^4.28.4",
    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0",
    "resend": "^3.2.0",
    "stripe": "^14.21.0",
    "twilio": "^5.0.4",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.11.30",
    "@types/uuid": "^9.0.8",
